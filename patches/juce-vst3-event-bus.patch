+++ b/modules/juce_audio_processors_headless/format_types/juce_VST3PluginFormatImpl.h
@@ -2251,10 +2251,84 @@ public:
     {
         // MIDI mappings will always be updated on the main thread, but we need to ensure
         // that we're not simultaneously reading them on the audio thread.
+        // [orchestral-daw patch] Every event input bus, and the program-change parameters, are
+        // read first (outside the lock: a plugin can have tens of thousands of parameters)
+        const auto numEventBuses = holder->component != nullptr
+                                     ? jmax (1, (int) holder->component->getBusCount (Vst::kEvent, Vst::kInput)) : 1;
+        auto programParameters = findProgramParameters (numEventBuses);
+
         const SpinLock::ScopedLockType processLock (processMutex);
 
         if (midiMapping != nullptr)
-            storedMidiMapping.storeMappings (*midiMapping);
+            storedMidiMapping.storeMappings (*midiMapping, numEventBuses);
+
+        storedMidiMapping.storeProgramParameters (std::move (programParameters));
+    }
+
+    // [orchestral-daw patch] Which parameter takes a program change on each event bus and
+    // channel: the kIsProgramChange parameter of the unit the bus/channel belongs to
+    // (IUnitInfo::getUnitByBus), as VST3 hosts do. Plugins that don't say which unit, but
+    // have one program parameter per bus and channel (Vienna Ensemble Pro: 16 ports x 16),
+    // get them in order; a plugin with a single one gets it on the first bus.
+    std::vector<std::array<StoredMidiMapping::ProgramParameter, 16>> findProgramParameters (int numEventBuses) const
+    {
+        std::vector<std::array<StoredMidiMapping::ProgramParameter, 16>> table ((size_t) numEventBuses);
+
+        if (editController == nullptr)
+            return table;
+
+        struct Candidate { Vst::ParamID id; Vst::UnitID unit; int32 stepCount; };
+        std::vector<Candidate> candidates;
+        const auto count = editController->getParameterCount();
+
+        for (int32 i = 0; i < count; ++i)
+        {
+            Vst::ParameterInfo parameterInfo{};
+
+            if (editController->getParameterInfo (i, parameterInfo) == kResultOk
+                 && (parameterInfo.flags & Vst::ParameterInfo::kIsProgramChange) != 0)
+                candidates.push_back ({ parameterInfo.id, parameterInfo.unitId,
+                                        parameterInfo.stepCount > 0 ? parameterInfo.stepCount : 127 });
+        }
+
+        if (candidates.empty())
+            return table;
+
+        auto assigned = false;
+
+        if (unitInfo != nullptr)
+            for (int bus = 0; bus < numEventBuses; ++bus)
+                for (int channel = 0; channel < 16; ++channel)
+                {
+                    Vst::UnitID unit{};
+
+                    if (unitInfo->getUnitByBus (Vst::kEvent, Vst::kInput, bus, channel, unit) != kResultOk)
+                        continue;
+
+                    for (auto& c : candidates)
+                        if (c.unit == unit)
+                        {
+                            table[(size_t) bus][(size_t) channel] = { c.id, c.stepCount };
+                            assigned = true;
+                            break;
+                        }
+                }
+
+        if (assigned)
+            return table;
+
+        if ((int) candidates.size() == numEventBuses * 16)
+        {
+            for (size_t i = 0; i < candidates.size(); ++i)
+                table[i / 16][i % 16] = { candidates[i].id, candidates[i].stepCount };
+        }
+        else if (candidates.size() == 1)
+        {
+            for (auto& slot : table.front())
+                slot = { candidates.front().id, candidates.front().stepCount };
+        }
+
+        return table;
     }
 
